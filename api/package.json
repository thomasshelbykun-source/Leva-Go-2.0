{
  "name": "levago-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler/state",
    "db:migrate:local": "wrangler d1 migrations apply levago --local --persist-to .wrangler/state",
    "db:seed:local": "wrangler d1 execute levago --local --persist-to .wrangler/state --file seed/staging.sql",
    "test": "vitest run",
    "test:e2e": "node test/e2e.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.151.3"
  }
}
