{
  "name": "levago-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/migrate.ts --seed",
    "make-admin": "tsx scripts/make-admin.ts",
    "test": "vitest run",
    "test:e2e": "node test/e2e.mjs",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "dev:workers": "wrangler dev"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.5",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.157.0"
  },
  "engines": {
    "node": "22.x"
  }
}
